# Copy this file to .env and fill it in. Never commit .env.

# From the Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=
# Your server's ID (Developer Mode on, right-click the server icon → Copy Server ID)
GUILD_ID=

# The lookup tables Google Sheet (the long ID in its web address). Already filled in for the game's Sheet.
TABLES_SHEET_ID=1ubSMUIj99iqO6Dx_BE7EbwDM6_96uyfE2pmGIuhY6Rg

# Nightly closing bell (rounds also open at this time on their dates). Midnight Pacific.
UPDATE_HOUR=0
UPDATE_MINUTE=0
TIMEZONE=America/Los_Angeles

# Public rankings page (US Snooze & Whirled Retort) on GitHub Pages. See README. Leave blank to skip.
SITE_GITHUB_TOKEN=
SITE_REPO=markcmarino/how-rank-is-your-college
SITE_BRANCH=gh-pages

# Optional: AI-written consequences (off unless you run /admin mode). Leave blank to use the tables.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Channel names (only change these if you rename the channels)
# ANNOUNCEMENTS_CHANNEL=announcements
# FAIR_CHANNEL=college-fair-pitches
# STUDENTS_CHANNEL=meet-the-students
# POLICY_CHANNEL=policies
# DIARY_CHANNEL=secret-diaries
# EXCHANGE_CHANNEL=the-exchange
