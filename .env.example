# Copy this file to .env and fill it in. Never commit .env.

# From the Discord Developer Portal → your application → Bot → Reset Token
DISCORD_TOKEN=
# Your server's ID (Developer Mode on, right-click the server icon → Copy Server ID)
GUILD_ID=

# Daily closing bell
UPDATE_HOUR=18
UPDATE_MINUTE=0
TIMEZONE=America/Los_Angeles

# Optional: Claude writes the consequences. Leave blank to use the random tables.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Create a private channel for each team when it is founded
CREATE_TEAM_CHANNELS=true

# Channel names (optional overrides)
# ANNOUNCEMENTS_CHANNEL=announcements
# EXCHANGE_CHANNEL=the-exchange
# POLICY_CHANNEL=policy-register
# DIARY_CHANNEL=secret-diaries
# FAIR_CHANNEL=college-fair
# TEAM_CATEGORY=Universities
